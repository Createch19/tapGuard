// TapGate — Full Database Schema
// Prisma 7 with PostgreSQL (Supabase)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────

enum TenantPlan {
  BASIC
  PRO
  ENTERPRISE
}

enum BillingCycle {
  LIFETIME
  MONTHLY
  YEARLY
  CUSTOM
}

enum UserRole {
  SUPER_ADMIN
  OWNER
  MANAGER
  STAFF
}

enum CardStatus {
  UNASSIGNED
  ACTIVE
  DEACTIVATED
  LOST
}

enum GateTemplate {
  GOOGLE_REVIEW
  SOCIAL_HUB
  DELIVERY_DINING
  CUSTOM_REDIRECT
}

enum TapOutcome {
  REDIRECTED
  FEEDBACK_CAPTURED
  DIRECT_REDIRECT
  BOUNCED
  REVIEW_COPIED
}

enum DeviceOS {
  IOS
  ANDROID
  DESKTOP
  UNKNOWN
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum AuditAction {
  TENANT_CREATED
  TENANT_UPDATED
  TENANT_SUSPENDED
  TENANT_DELETED
  SUBSCRIPTION_CREATED
  SUBSCRIPTION_UPDATED
  SUBSCRIPTION_CANCELLED
  PLAN_CONFIG_UPDATED
  CARD_BATCH_GENERATED
  CARD_REASSIGNED
  USER_ROLE_CHANGED
  ADMIN_LOGIN
}

enum KeywordTone {
  CASUAL
  ENTHUSIASTIC
  DETAILED
  SHORT
}

// ─── Tenants ─────────────────────────────────────────────

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String       @unique
  googleReviewUrl      String?      @map("google_review_url")
  smartGateEnabled     Boolean      @default(true) @map("smart_gate_enabled")
  greetingTitle        String       @default("How was your experience?") @map("greeting_title")
  greetingSubtitle     String?      @map("greeting_subtitle")
  gateTemplate         GateTemplate @default(GOOGLE_REVIEW) @map("gate_template")
  instagramUrl         String?      @map("instagram_url")
  facebookUrl          String?      @map("facebook_url")
  youtubeUrl           String?      @map("youtube_url")
  swiggyUrl            String?      @map("swiggy_url")
  zomatoUrl            String?      @map("zomato_url")
  deliveryOfferText    String?      @map("delivery_offer_text")
  deliveryPhone        String?      @map("delivery_phone")
  customRedirectUrl    String?      @map("custom_redirect_url")
  customRedirectTitle  String?      @default("View Online Menu") @map("custom_redirect_title")
  customRedirectDirect Boolean      @default(false) @map("custom_redirect_direct")
  plan                 TenantPlan   @default(BASIC)
  businessType         String?      @default("Restaurant & Café") @map("business_type")
  isActive             Boolean      @default(true) @map("is_active")
  maxCards             Int          @default(5) @map("max_cards")
  webhookUrl           String?      @map("webhook_url")
  alertEmail           String?      @map("alert_email")
  googleBusinessEmail      String?      @map("google_business_email")
  googleLocationId         String?      @map("google_location_id")
  customGoogleClientId     String?      @map("custom_google_client_id")
  customGoogleClientSecret String?      @map("custom_google_client_secret")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  branding         TenantBranding?
  subscription     Subscription?
  users            User[]
  cards            Card[]
  tapEvents        TapEvent[]
  privateFeedback  PrivateFeedback[]
  reviewKeywords   TenantReviewKeyword?
  googleConnection GoogleProfileConnection?
  geminiConfig     TenantGeminiConfig?

  @@map("tenants")
}

// ─── Tenant Branding (Dynamic Theming) ───────────────────

model TenantBranding {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @map("tenant_id") @db.Uuid
  logoUrl        String?  @map("logo_url")
  primaryColor   String   @default("#0D9488") @map("primary_color")
  secondaryColor String   @default("#F0FDFA") @map("secondary_color")
  accentColor    String   @default("#14B8A6") @map("accent_color")
  fontFamily     String?  @map("font_family")
  customCss      Json?    @map("custom_css")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_branding")
}

// ─── Users ───────────────────────────────────────────────

model User {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?
  image         String?
  role          UserRole  @default(OWNER)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  tenant           Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  resolvedFeedback PrivateFeedback[] @relation("ResolvedBy")

  @@map("users")
}

// ─── NextAuth Required Tables ────────────────────────────

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Plan Configuration (Admin-Editable) ─────────────────

model PlanConfig {
  id               String       @id @default(uuid()) @db.Uuid
  plan             TenantPlan   @unique
  displayName      String       @map("display_name")
  description      String?
  price            Decimal      @db.Decimal(10, 2)
  currency         String       @default("INR") @db.VarChar(3)
  billingCycle     BillingCycle @map("billing_cycle")
  maxCards           Int          @map("max_cards")
  smartGate          Boolean      @default(true) @map("smart_gate")
  multiGateTemplates Boolean      @default(false) @map("multi_gate_templates")
  customBranding     Boolean      @default(false) @map("custom_branding")
  webhookAlerts    Boolean      @default(false) @map("webhook_alerts")
  keywordSuggestions Boolean      @default(false) @map("keyword_suggestions")
  googleHub        Boolean      @default(false) @map("google_hub")
  qrCodeTier       String       @default("basic") @map("qr_code_tier")
  analyticsRetDays Int          @default(30) @map("analytics_ret_days")
  prioritySupport  Boolean      @default(false) @map("priority_support")
  isActive         Boolean      @default(true) @map("is_active")
  sortOrder        Int          @default(0) @map("sort_order")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@map("plan_configs")
}

// ─── Subscriptions ───────────────────────────────────────

model Subscription {
  id                 String             @id @default(uuid()) @db.Uuid
  tenantId           String             @unique @map("tenant_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  plan               TenantPlan         @default(BASIC)
  billingCycle       BillingCycle       @default(LIFETIME) @map("billing_cycle")
  pricePaid          Decimal            @default(0) @map("price_paid") @db.Decimal(10, 2)
  currency           String             @default("INR") @db.VarChar(3)
  trialStartDate     DateTime?          @map("trial_start_date")
  trialEndDate       DateTime?          @map("trial_end_date")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelReason       String?            @map("cancel_reason")
  externalPaymentId  String?            @map("external_payment_id")
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([plan])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ─── Audit Log ───────────────────────────────────────────

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  actorId    String      @map("actor_id") @db.Uuid
  actorEmail String      @map("actor_email")
  action     AuditAction
  targetType String      @map("target_type")
  targetId   String?     @map("target_id") @db.Uuid
  metadata   Json?
  ipAddress  String?     @map("ip_address")
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Card Batches ────────────────────────────────────────

model CardBatch {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  quantity  Int
  prefix    String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  cards Card[]

  @@map("card_batches")
}

// ─── Cards / Hardware ────────────────────────────────────

model Card {
  id            String     @id @default(uuid()) @db.Uuid
  shortCode     String     @unique @map("short_code")
  urlSlug       String     @unique @map("url_slug")
  tenantId      String?    @map("tenant_id") @db.Uuid
  batchId       String?    @map("batch_id") @db.Uuid
  status        CardStatus @default(UNASSIGNED)
  label         String?
  activatedAt   DateTime?  @map("activated_at")
  deactivatedAt DateTime?  @map("deactivated_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  batch           CardBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  tapEvents       TapEvent[]
  privateFeedback PrivateFeedback[]

  @@index([tenantId])
  @@index([status])
  @@index([urlSlug])
  @@map("cards")
}

// ─── Tap Events (Analytics) ─────────────────────────────

model TapEvent {
  id        String     @id @default(uuid()) @db.Uuid
  cardId    String     @map("card_id") @db.Uuid
  tenantId  String?    @map("tenant_id") @db.Uuid
  deviceOs  DeviceOS   @default(UNKNOWN) @map("device_os")
  userAgent String?    @map("user_agent")
  ipHash    String?    @map("ip_hash")
  rating    Int?       @db.SmallInt
  outcome   TapOutcome @default(BOUNCED)
  referrer  String?
  country   String?    @db.VarChar(2)
  createdAt DateTime   @default(now()) @map("created_at")

  card     Card             @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tenant   Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  feedback PrivateFeedback?

  @@index([tenantId, createdAt])
  @@index([cardId, createdAt])
  @@index([outcome])
  @@map("tap_events")
}

// ─── Private Feedback ────────────────────────────────────

model PrivateFeedback {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  cardId       String    @map("card_id") @db.Uuid
  tapEventId   String    @unique @map("tap_event_id") @db.Uuid
  rating       Int       @db.SmallInt
  feedbackText String?   @map("feedback_text") @db.Text
  phoneNumber  String?   @map("phone_number")
  customerName String?   @map("customer_name")
  isResolved   Boolean   @default(false) @map("is_resolved")
  resolvedAt   DateTime? @map("resolved_at")
  resolvedById String?   @map("resolved_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tapEvent   TapEvent @relation(fields: [tapEventId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("ResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([isResolved])
  @@map("private_feedback")
}

// ─── Business Types Directory ────────────────────────────

model BusinessType {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  icon      String?  @default("Store")
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("business_types")
}

// ─── Tenant Review Keywords (SEO Engine) ─────────────────

model TenantReviewKeyword {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @unique @map("tenant_id") @db.Uuid
  isEnabled        Boolean     @default(true) @map("is_enabled")
  primaryLanguage  String      @default("EN") @map("primary_language")
  enabledLanguages String[]    @default(["EN", "TANGLISH", "TA"]) @map("enabled_languages")
  keywords         String[]    @default([])
  customSentences  String[]    @default([])
  tone             KeywordTone @default(CASUAL)
  lastServedIndex  Int         @default(0) @map("last_served_index")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  tenant           Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_review_keywords")
}

// ─── Google Account & Profile Connection ─────────────────

model GoogleProfileConnection {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @unique @map("tenant_id") @db.Uuid
  googleAccountId  String           @map("google_account_id")
  accountName      String?          @map("account_name")
  accessToken      String           @map("access_token") @db.Text
  refreshToken     String           @map("refresh_token") @db.Text
  tokenExpiresAt   DateTime         @map("token_expires_at")
  scope            String
  connectedEmail   String           @map("connected_email")
  isVerified       Boolean          @default(false) @map("is_verified")
  lastSyncedAt     DateTime?        @map("last_synced_at")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  tenant           Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations        GoogleLocation[]

  @@map("google_profile_connections")
}

// ─── Tenant Gemini AI Configuration ──────────────────────

model TenantGeminiConfig {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @map("tenant_id") @db.Uuid
  customApiKey      String?  @map("custom_api_key")
  model             String   @default("gemini-1.5-flash")
  brandTone         String   @default("WARM") @map("brand_tone")
  customPersona     String?  @map("custom_persona") @db.Text
  knowledgeBase     String?  @map("knowledge_base") @db.Text
  escalationPhone   String?  @map("escalation_phone")
  escalationEmail   String?  @map("escalation_email")
  autoPilot5Star    Boolean  @default(false) @map("auto_pilot_5_star")
  minConfidence     Int      @default(85) @map("min_confidence")
  autoMatchLanguage Boolean  @default(true) @map("auto_match_language")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_gemini_configs")
}

// ─── Google Locations (Multi-Location Support) ────────────

model GoogleLocation {
  id                 String                   @id @default(uuid()) @db.Uuid
  connectionId       String                   @map("connection_id") @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  googleLocationId   String                   @unique @map("google_location_id")
  placeId            String?                  @map("place_id")
  title              String
  storeCode          String?                  @map("store_code")
  primaryPhone       String?                  @map("primary_phone")
  websiteUri         String?                  @map("website_uri")
  addressJson        Json                     @map("address_json")
  coordinatesLat     Float?                   @map("coordinates_lat")
  coordinatesLng     Float?                   @map("coordinates_lng")
  regularHoursJson   Json?                    @map("regular_hours_json")
  specialHoursJson   Json?                    @map("special_hours_json")
  primaryCategory    String?                  @map("primary_category")
  attributesJson     Json?                    @map("attributes_json")
  autoReplyReviews   Boolean                  @default(false) @map("auto_reply_reviews")
  autoAnswerQA       Boolean                  @default(false) @map("auto_answer_qa")
  isPrimaryBranch    Boolean                  @default(true) @map("is_primary_branch")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  connection         GoogleProfileConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reviews            GoogleReview[]
  questions          GoogleQuestion[]
  posts              GooglePost[]
  menuSections       GoogleMenuSection[]
  mediaItems         GoogleMediaItem[]
  performanceDaily   GooglePerformanceDaily[]

  @@map("google_locations")
}

// ─── Google Reviews & Replies ─────────────────────────────

model GoogleReview {
  id                 String         @id @default(uuid()) @db.Uuid
  locationId         String         @map("location_id") @db.Uuid
  googleReviewId     String         @unique @map("google_review_id")
  reviewerName       String         @map("reviewer_name")
  reviewerPhotoUrl   String?        @map("reviewer_photo_url")
  isAnonymous        Boolean        @default(false) @map("is_anonymous")
  rating             Int
  comment            String?        @db.Text
  replyComment       String?        @map("reply_comment") @db.Text
  replyUpdatedAt     DateTime?      @map("reply_updated_at")
  geminiDraftReply   String?        @map("gemini_draft_reply") @db.Text
  reviewCreatedAt    DateTime       @map("review_created_at")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  location           GoogleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, rating])
  @@map("google_reviews")
}

// ─── Google Maps Q&A ─────────────────────────────────────

model GoogleQuestion {
  id                String         @id @default(uuid()) @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  googleQuestionId  String         @unique @map("google_question_id")
  authorName        String         @map("author_name")
  authorPhotoUrl    String?        @map("author_photo_url")
  questionText      String         @map("question_text") @db.Text
  upvoteCount       Int            @default(0) @map("upvote_count")
  officialAnswer    String?        @map("official_answer") @db.Text
  officialAnswerId  String?        @map("official_answer_id")
  geminiDraftAnswer String?        @map("gemini_draft_answer") @db.Text
  isAnswered        Boolean        @default(false) @map("is_answered")
  questionCreatedAt DateTime       @map("question_created_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  location          GoogleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId, isAnswered])
  @@map("google_questions")
}

// ─── Structured Menu Sections & Items ────────────────────

model GoogleMenuSection {
  id         String           @id @default(uuid()) @db.Uuid
  locationId String           @map("location_id") @db.Uuid
  title      String
  sortOrder  Int              @default(0) @map("sort_order")
  items      GoogleMenuItem[]

  location   GoogleLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("google_menu_sections")
}

model GoogleMenuItem {
  id          String            @id @default(uuid()) @db.Uuid
  sectionId   String            @map("section_id") @db.Uuid
  name        String
  description String?           @db.Text
  price       Decimal           @db.Decimal(10, 2)
  currency    String            @default("INR") @db.VarChar(3)
  imageUrl    String?           @map("image_url")
  isAvailable Boolean           @default(true) @map("is_available")
  dietaryTags String[]          @default([]) @map("dietary_tags")
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  section     GoogleMenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("google_menu_items")
}

// ─── Google Posts & Offers ────────────────────────────────

model GooglePost {
  id              String         @id @default(uuid()) @db.Uuid
  locationId      String         @map("location_id") @db.Uuid
  googlePostId    String?        @unique @map("google_post_id")
  topicType       String         @default("STANDARD") @map("topic_type")
  summary         String         @db.Text
  callToAction    String?        @map("call_to_action")
  actionUrl       String?        @map("action_url")
  mediaUrl        String?        @map("media_url")
  couponCode      String?        @map("coupon_code")
  termsConditions String?        @map("terms_conditions") @db.Text
  startDate       DateTime?      @map("start_date")
  endDate         DateTime?      @map("end_date")
  status          String         @default("DRAFT")
  publishedAt     DateTime?      @map("published_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  location        GoogleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("google_posts")
}

// ─── Media & Photo Management ────────────────────────────

model GoogleMediaItem {
  id                String         @id @default(uuid()) @db.Uuid
  locationId        String         @map("location_id") @db.Uuid
  googleMediaId     String?        @unique @map("google_media_id")
  mediaFormat       String         @default("PHOTO") @map("media_format")
  category          String         @default("ADDITIONAL")
  sourceUrl         String         @map("source_url")
  thumbnailUrl      String?        @map("thumbnail_url")
  isCustomerUser    Boolean        @default(false) @map("is_customer_user")
  flaggedForRemoval Boolean        @default(false) @map("flagged_for_removal")
  flagReason        String?        @map("flag_reason")
  createdAt         DateTime       @default(now()) @map("created_at")

  location          GoogleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("google_media_items")
}

// ─── Daily Local Search Performance Metrics ──────────────

model GooglePerformanceDaily {
  id                 String         @id @default(uuid()) @db.Uuid
  locationId         String         @map("location_id") @db.Uuid
  date               DateTime       @db.Date
  searchImpressions  Int            @default(0) @map("search_impressions")
  mapsImpressions    Int            @default(0) @map("maps_impressions")
  callClicks         Int            @default(0) @map("call_clicks")
  websiteClicks      Int            @default(0) @map("website_clicks")
  directionsRequests Int            @default(0) @map("directions_requests")
  bookingsClicks     Int            @default(0) @map("bookings_clicks")
  topQueriesJson     Json?          @map("top_queries_json")

  location           GoogleLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, date])
  @@map("google_performance_daily")
}

// ─── Platform System Settings ────────────────────────────

model SystemSetting {
  key       String   @id
  value     String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
